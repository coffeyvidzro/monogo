# Normalize text files to LF
* text=auto eol=lf

# Go
*.go text diff=golang

# Shell
*.sh text eol=lf

# YAML / JSON / TOML / HCL
*.yaml text
*.yml text
*.json text
*.toml text
*.hcl text

# SQL
*.sql text

# Checksum files
*.sum text eol=lf

# Markdown
*.md text

# Makefiles
Makefile text eol=lf

# Docker
Dockerfile text eol=lf

# Images / binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary

# Archives
*.zip binary
*.tar binary
*.gz binary
