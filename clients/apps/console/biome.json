{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "extends": ["../../biome.json"],
  "files": {
    "includes": [
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!components/ui",
      "!turbo",
      "!public/**/*.svg"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
