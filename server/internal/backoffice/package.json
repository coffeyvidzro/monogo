  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tailwindcss -i ./assets/static/css/styles.css -o ./assets/static/css/tailwindcss.css --minify && node -e \"const fs=require('fs');fs.copyFileSync('./node_modules/htmx.org/dist/htmx.min.js','./assets/static/js/htmx.min.js');fs.copyFileSync('./node_modules/hyperscript.org/dist/_hyperscript.min.js','./assets/static/js/hyperscript.min.js');\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.32",
    "htmx.org": "4.0.0",
    "hyperscript.org": "0.9.93",
    "tailwindcss": "4.3.3"
  }
}
