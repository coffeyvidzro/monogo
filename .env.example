# Deployment
LEAMOUT_DEPLOYMENT_ID=cloud-primary
DOMAIN=example.com
SIP_DOMAIN=sip.example.com
PUBLIC_IP=203.0.113.10
CORS_ORIGINS=https://example.com
LEAMOUT_SESSION_COOKIE_DOMAIN=.example.com

# PostgreSQL
POSTGRES_PASSWORD=change-me-postgres

# FreeSWITCH
FREESWITCH_ESL_PASSWORD=change-me-freeswitch

# Carrier credential encryption
# Replace with a raw URL-safe base64 encoded 16, 24, or 32 byte AES key.
CARRIER_CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# TURN
TURN_AUTH_SECRET=change-me-turn-secret
TURN_REALM=turn.example.com
TURN_PUBLIC_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# Carrier providers
DIDWW_API_KEY=
COMMPEAK_API_AUTHORIZATION=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
