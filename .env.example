# Deployment
DOMAIN=leamout.com
PUBLIC_IP=203.0.113.10
CORS_ORIGINS=https://leamout.com

# PostgreSQL
POSTGRES_PASSWORD=change-me-postgres

# FreeSWITCH
FREESWITCH_ESL_PASSWORD=change-me-freeswitch

# Encryption
# Replace with a raw URL-safe base64 encoded 16, 24, or 32 byte AES key.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# TURN
TURN_AUTH_SECRET=change-me-turn-secret

# Carrier providers (required for API and worker startup)
# Placeholder values for Compose validation only; replace in your private deployment env.
DIDWW_API_KEY=example-placeholder
COMMPEAK_API_AUTHORIZATION=example-placeholder

# Payments (required for API and worker startup)
STRIPE_SECRET_KEY=example-placeholder
STRIPE_WEBHOOK_SECRET=example-placeholder
PAYSTACK_SECRET_KEY=example-placeholder

# Recording object storage
MINIO_ROOT_USER=leamout-recordings
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_APP_ACCESS_KEY=leamout-app
MINIO_APP_SECRET_KEY=change-me-minio-app-password
