# Deployment
DOMAIN=leamout.com
PUBLIC_IP=203.0.113.10
CORS_ORIGINS=https://leamout.com

# PostgreSQL
POSTGRES_PASSWORD=change-me-postgres

# FreeSWITCH
FREESWITCH_ESL_PASSWORD=change-me-freeswitch

# Realtime media plane
MEDIA_TOKEN_SECRET=change-me-media-token-secret-at-least-32-bytes
MEDIA_CONTROL_TOKEN=change-me-media-control-token-at-least-32-bytes
MEDIA_MAX_SESSIONS=100
# Optional. Enables the integrated OpenAI Realtime engine when set.
OPENAI_API_KEY=
# Optional. All four values enable the composable Deepgram Flux, Groq, and
# Cartesia Sonic 3.6 engine. Flux provides turn detection by default.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Encryption
# Replace with a raw URL-safe base64 encoded 16, 24, or 32 byte AES key.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# TURN
TURN_AUTH_SECRET=change-me-turn-secret

# Carrier providers (required for API and worker startup)
# Placeholder values for Compose validation only; replace in your private deployment env.
DIDWW_API_KEY=example-placeholder
COMMPEAK_API_AUTHORIZATION=example-placeholder

# Recording object storage
MINIO_ROOT_USER=leamout-recordings
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_APP_ACCESS_KEY=leamout-app
MINIO_APP_SECRET_KEY=change-me-minio-app-password
