# Deployment
DOMAIN=leamout.com
PUBLIC_IP=203.0.113.10
CORS_ORIGINS=https://leamout.com
# Optional comma-separated CIDRs for reverse proxies whose X-Forwarded-For
# chain may be trusted when enforcing organization network policies.
TRUSTED_PROXY_CIDRS=

# PostgreSQL
POSTGRES_PASSWORD=change-me-postgres

# FreeSWITCH
FREESWITCH_ESL_PASSWORD=change-me-freeswitch

# Realtime media plane
MEDIA_TOKEN_SECRET=change-me-media-token-secret-at-least-32-bytes
MEDIA_CONTROL_URL=http://127.0.0.1:8090
MEDIA_CONTROL_TOKEN=change-me-media-control-token-at-least-32-bytes
MEDIA_MAX_SESSIONS=100
# Deepgram, Groq, Cartesia, and OpenAI credentials are organization-scoped and
# stored through the AI provider credential API. Per-agent provider options
# such as a Cartesia voice ID belong in the Voice Agent/provider binding
# configuration.

# Encryption
# Replace with a raw URL-safe base64 encoded 16, 24, or 32 byte AES key.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# TURN
TURN_AUTH_SECRET=change-me-turn-secret


# Recording object storage
MINIO_ROOT_USER=leamout-recordings
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_APP_ACCESS_KEY=leamout-app
MINIO_APP_SECRET_KEY=change-me-minio-app-password
